# Copy this file to .env and fill in your values

# App
DEBUG=false
CITY=Philadelphia
TIMEZONE=America/New_York

# Database (defaults to SQLite — swap for postgres in prod)
DATABASE_URL=sqlite:///./radar.db
# Local PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost/radar
# Azure Database for PostgreSQL (Flexible Server):
# DATABASE_URL=postgresql://user:pass@<server>.postgres.database.azure.com/radar?sslmode=require
# Azure Database for PostgreSQL (Single Server — legacy, username must include @server):
# DATABASE_URL=postgresql://user%40<server>:pass@<server>.postgres.database.azure.com/radar?sslmode=require

# Hour of day to run the full scrape (24h clock, local timezone). Default: 23 = 11 PM
SCRAPE_HOUR=23

# Google Calendar OAuth (download credentials.json from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Public base URL of this server (used to build yes/no/maybe links in pushed events)
APP_BASE_URL=http://localhost:8000

# Admin key for the /admin/sync endpoint (leave blank to allow open access in dev)
PARTNER_API_KEY=
