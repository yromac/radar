# Copy this file to .env and fill in your values

# App
DEBUG=false
CITY=Philadelphia
TIMEZONE=America/New_York

# Database (defaults to SQLite — swap for postgres in prod)
DATABASE_URL=sqlite:///./radar.db
# DATABASE_URL=postgresql://user:pass@localhost/radar

# How often to re-scrape event sources (minutes)
SCRAPE_INTERVAL_MINUTES=60

# Google Calendar OAuth (download credentials.json from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Admin key for the /admin/sync endpoint (leave blank to allow open access in dev)
PARTNER_API_KEY=
